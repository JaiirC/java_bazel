# Configuración de Java
build --java_language_version=21
build --java_runtime_version=remotejdk_21
build --tool_java_runtime_version=remotejdk_21

# Evitar problemas con toolchain de C++
build --action_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
run --action_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# Configuración adicional recomendada para Windows
build --enable_platform_specific_config
build --java_runtime_version=remotejdk_21
build --tool_java_runtime_version=remotejdk_21

# Habilitar soporte para WORKSPACE (requerido en Bazel 8+)
#build --incompatible_disable_workspace=false
